<?xml version="1.0" encoding="utf-8"?>
<com.android.calculator2.history.layout.laskin.HistoryLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:clickable="true"
    android:clipChildren="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:importantForAccessibility="no">
    <android.support.v7.widget.RecyclerView
        android:id="@+id/history_recycler_view"
        android:background="?attr/colorSurfaceContainer"
        android:paddingBottom="@dimen/history_list_padding"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:fastScrollEnabled="true"
        app:fastScrollHorizontalThumbDrawable="@drawable/thumb_drawable"
        app:fastScrollHorizontalTrackDrawable="@drawable/line_drawable"
        app:fastScrollVerticalThumbDrawable="@drawable/thumb_drawable"
        app:fastScrollVerticalTrackDrawable="@drawable/line_drawable"
        app:layoutManager="LinearLayoutManager"
        app:reverseLayout="true"/>
</com.android.calculator2.history.layout.laskin.HistoryLayout>

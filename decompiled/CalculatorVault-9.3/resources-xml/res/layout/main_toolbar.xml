<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.appbar.MaterialToolbar xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="top"
    android:id="@+id/main_toolbar"
    android:layout_width="match_parent"
    android:layout_height="?android:attr/actionBarSize"
    android:layoutDirection="locale"
    app:contentInsetStart="0dp"
    app:popupTheme="@style/ThemeOverlay.Popup"
    style="@style/ToolbarStyle">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/history_toggle_button"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="?attr/colorOnSurfaceVariant"
        android:contentDescription="@string/desc_toggle_history_off"
        android:layout_marginStart="@dimen/history_toggle_button_margin_start"
        android:tooltipText="@string/desc_toggle_history_off"
        app:icon="@drawable/gs_history_vd_theme_24"
        style="?attr/materialIconButtonStyle"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/history_toggle_button_filled"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:tint="?attr/colorOnSurfaceVariant"
        android:contentDescription="@string/desc_toggle_history_on"
        android:layout_marginStart="@dimen/history_toggle_button_margin_start"
        android:tooltipText="@string/desc_toggle_history_on"
        app:icon="@drawable/gs_history_vd_theme_24"
        style="?attr/materialIconButtonFilledTonalStyle"/>
    <com.google.android.material.button.MaterialButton
        android:layout_gravity="end|top"
        android:id="@+id/overflow_action_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/overflow_button_margin_top"
        android:tint="?attr/colorOnSurfaceVariant"
        android:contentDescription="@string/abc_action_menu_overflow_description"
        android:layout_marginEnd="@dimen/overflow_button_margin_end"
        android:tooltipText="@string/abc_action_menu_overflow_description"
        app:backgroundTint="@color/overflow_button_background_selector"
        app:icon="@drawable/gs_more_vert_vd_theme_24"
        style="?attr/materialIconButtonStyle"/>
</com.google.android.material.appbar.MaterialToolbar>

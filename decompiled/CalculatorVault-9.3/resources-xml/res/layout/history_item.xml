<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="@dimen/history_divider_padding"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/history_divider"
        android:background="?android:attr/listDivider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/history_divider_padding"
        android:layout_marginBottom="@dimen/history_divider_padding"
        android:importantForAccessibility="no"/>
    <com.android.calculator2.common.view.cutandcopy.CopyableTextView
        android:id="@+id/history_date"
        android:clickable="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/title_current_expression"
        android:importantForAccessibility="yes"
        android:paddingStart="@dimen/history_date_padding_start"
        style="@style/HistoryDateLabelStyle"/>
    <com.android.calculator2.common.view.scrollview.CalculatorScrollView
        android:id="@+id/history_formula_container"
        android:scrollbars="none"
        android:clipToPadding="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:layoutDirection="ltr">
        <com.android.calculator2.history.view.HistoryFormula
            android:ellipsize="none"
            android:id="@+id/history_formula"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:cursorVisible="false"
            android:textIsSelectable="true"
            android:textDirection="ltr"
            style="@style/HistoryFormulaTextStyle"/>
    </com.android.calculator2.common.view.scrollview.CalculatorScrollView>
    <com.android.calculator2.history.view.HistoryResult
        android:id="@+id/history_result"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:bufferType="spannable"
        android:maxLines="1"
        android:layoutDirection="ltr"
        style="@style/HistoryResultTextStyle"/>
</LinearLayout>

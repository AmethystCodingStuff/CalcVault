<?xml version="1.0" encoding="utf-8"?>
<ConstraintSet xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/history_open_advanced_expanded_inverted"
    app:deriveConstraintsFrom="@+id/history_closed_advanced_expanded_inverted">
    <Constraint
        android:orientation="horizontal"
        android:id="@+id/history_top_guideline"
        app:layout_constraintGuide_percent="@fraction/history_open_history_top_screen_percent"/>
    <Constraint
        android:orientation="horizontal"
        android:id="@+id/history_display_divider"
        app:layout_constraintGuide_percent="@fraction/history_open_history_display_divider_screen_percent"/>
    <Constraint
        android:orientation="horizontal"
        android:id="@+id/display_collapse_expand_button_divider"
        app:layout_constraintGuide_percent="@fraction/history_open_display_collapse_expand_button_divider_screen_percent"/>
    <Constraint
        android:orientation="horizontal"
        android:id="@+id/collapse_expand_button_keypad_divider"
        app:layout_constraintGuide_percent="@fraction/history_open_collapse_expand_button_keypad_divider_screen_percent"/>
    <Constraint
        android:orientation="horizontal"
        android:id="@+id/basic_bottom_guideline"
        app:layout_constraintGuide_percent="@fraction/history_open_basic_bottom_screen_percent"/>
    <Constraint
        android:id="@+id/display"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/history_display_divider"/>
</ConstraintSet>
